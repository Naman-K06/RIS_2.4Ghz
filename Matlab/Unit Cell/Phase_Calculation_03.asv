clear; close all; clc;

%% Project Folders

ProjectFolder = 'C:\Users\Naman\Desktop\Capstone\Matlab';

DataFolder    = fullfile(ProjectFolder,'Data');
FigureFolder  = fullfile(ProjectFolder,'Figures');
ResultFolder  = fullfile(ProjectFolder,'Results');

% Create folders if they don't exist
if ~exist(DataFolder,'dir')
    mkdir(DataFolder);
end

if ~exist(FigureFolder,'dir')
    mkdir(FigureFolder);
end

if ~exist(ResultFolder,'dir')
    mkdir(ResultFolder);
end

%% 03_Phase_Calculation.m
% =========================================================================
% Reconfigurable Intelligent Surface (RIS) Research Project
% Script 3: Beam Steering Phase Calculation and Quantization
% 
% Description:
%   This script calculates the required reflection phase for every RIS 
%   element to steer a 2.45 GHz incident wave from a Transmitter (Tx) 
%   toward a Receiver (Rx). The script calculates spherical wave 
%   propagation distances, wraps phases, quantizes them into binary 
%   ON/OFF states, and visualizes the results.
% =========================================================================



%% ========================================================================
% SECTION 1 – LOAD DATA
% =========================================================================
disp('Initializing Phase Calculation...'); %[output:1bcadaab]

% File names
paramsFile = fullfile(DataFolder,'HFSS_Parameters.mat');

geomFile   = fullfile(DataFolder,'RIS_Array.mat');

% Check if required files exist before loading
if ~isfile(paramsFile)
    error('File "%s" not found! Please ensure Script 1 has been run.', paramsFile);
end
if ~isfile(geomFile)
    error('File "%s" not found! Please ensure Script 2 has been run.', geomFile);
end

% Load parameters and geometry
load(paramsFile);
load(geomFile);

disp('HFSS Parameters Loaded Successfully'); %[output:411384fa]

%% ========================================================================
% SECTION 2 – USER INPUTS
% =========================================================================
% Define Transmitter (Tx) and Receiver (Rx) coordinates in meters (x, y, z)
Tx = [-2, 0, 1.5]; % Transmitter position
Rx = [3, 2, 1.2];  % Receiver position

%% ========================================================================
% SECTION 3 – DISTANCE CALCULATIONS
% =========================================================================
% Ensure RIS coordinates are in meters for k-space phase calculations
% If max X coordinate is large (> 5), it is likely in mm and needs conversion
if max(abs(RIS.X(:))) > 5 
    X_m = RIS.X / 1000; 
    Y_m = RIS.Y / 1000; 
    Z_m = RIS.Z / 1000;
else
    X_m = RIS.X; 
    Y_m = RIS.Y; 
    Z_m = RIS.Z;
end

% Incident distance (Ri): Distance from Tx to every RIS element
Ri = sqrt((X_m - Tx(1)).^2 + (Y_m - Tx(2)).^2 + (Z_m - Tx(3)).^2);

% Reflection distance (Rr): Distance from every RIS element to Rx
Rr = sqrt((X_m - Rx(1)).^2 + (Y_m - Rx(2)).^2 + (Z_m - Rx(3)).^2);

%% ========================================================================
% SECTION 4 – REQUIRED REFLECTION PHASE
% =========================================================================
% Calculate total propagation phase compensation: Phi = -k * (Ri + Rr)
PhaseRequired_rad = -k * (Ri + Rr);

% Convert the required phase from radians to degrees
PhaseRequired_deg = (PhaseRequired_rad * 180) / pi;

% Wrap the phase to be within the standard [-180, 180] degree interval
% This custom wrap prevents requiring the Mapping Toolbox (wrapTo180)
PhaseWrapped = mod(PhaseRequired_deg + 180, 360) - 180;

%% ========================================================================
% SECTION 5 – PHASE QUANTIZATION
% =========================================================================
% Calculate circular distance to each available state to handle wrap-around
% Available states are ON (148.9 deg) and OFF (-70.3 deg)
distON  = abs(mod(PhaseWrapped - Phase_ON_deg + 180, 360) - 180);
distOFF = abs(mod(PhaseWrapped - Phase_OFF_deg + 180, 360) - 180);

% Initialize state matrices
RIS_State = zeros(Ny, Nx);
ControlMatrix = zeros(Ny, Nx);

% Generic vector-based quantization algorithm (avoids loops)
% Elements closer to the ON phase are assigned 1, otherwise 0
RIS_State(distON <= distOFF) = 1; % ON state
RIS_State(distON > distOFF)  = 0; % OFF state

ControlMatrix = RIS_State; % They share the same binary topology

%% ========================================================================
% SECTION 6 – SAVE RESULTS
% =========================================================================
% Aggregate data into a struct for clean storage
PhaseData.PhaseRequired      = PhaseRequired_deg;
PhaseData.PhaseWrapped       = PhaseWrapped;
PhaseData.RIS_State          = RIS_State;
PhaseData.ControlMatrix      = ControlMatrix;
PhaseData.Tx                 = Tx;
PhaseData.Rx                 = Rx;
PhaseData.IncidentDistance   = Ri;
PhaseData.ReflectionDistance = Rr;

save('Phase_Data.mat', 'PhaseData');

%% ========================================================================
% SECTION 7 – VISUALIZATION
% =========================================================================
fontName = 'Times New Roman';
fontSize = 12;

% -------------------------------------------------------------------------
% Figure 1: Continuous Phase Distribution
% -------------------------------------------------------------------------
fig1 = figure('Name', 'Continuous Phase', 'Color', 'w', 'Position', [100 100 600 500]); %[output:8a79105a]
imagesc(PhaseWrapped); %[output:8a79105a]
colormap(turbo); %[output:8a79105a]
c = colorbar; %[output:8a79105a]
c.Label.String = 'Phase (Degrees)'; %[output:8a79105a]
axis equal tight; %[output:8a79105a]
title('Required Reflection Phase', 'FontWeight', 'bold', 'FontSize', fontSize+2); %[output:8a79105a]
xlabel('Element Index X'); %[output:8a79105a]
ylabel('Element Index Y'); %[output:8a79105a]
set(gca, 'YDir', 'normal', 'FontName', fontName, 'FontSize', fontSize); %[output:8a79105a]

% -------------------------------------------------------------------------
% Figure 2: Binary ON/OFF Map
% -------------------------------------------------------------------------
fig2 = figure('Name', 'Binary Map', 'Color', 'w', 'Position', [150 150 600 500]); %[output:4c5fc109]
imagesc(ControlMatrix); %[output:4c5fc109]
% Create custom Red (OFF) and Green (ON) colormap
colormap([0.85 0.15 0.15; 0.15 0.85 0.15]); %[output:4c5fc109]
axis equal tight; %[output:4c5fc109]
title('Binary ON/OFF State', 'FontWeight', 'bold', 'FontSize', fontSize+2); %[output:4c5fc109]
xlabel('Element Index X'); %[output:4c5fc109]
ylabel('Element Index Y'); %[output:4c5fc109]
set(gca, 'YDir', 'normal', 'FontName', fontName, 'FontSize', fontSize); %[output:4c5fc109]

% Display element numbers (1 to TotalElements) inside the cells
hold on; %[output:4c5fc109]
idx = 1;
for row = 1:Ny %[output:group:1145fe70]
    for col = 1:Nx
        % Choose text color based on background for contrast
        text(col, row, num2str(idx), 'HorizontalAlignment', 'center', ... %[output:4c5fc109]
             'VerticalAlignment', 'middle', 'Color', 'w', 'FontWeight', 'bold', 'FontSize', 8); %[output:4c5fc109]
        idx = idx + 1;
    end
end %[output:group:1145fe70]

% -------------------------------------------------------------------------
% Figure 3: 3D Geometry
% -------------------------------------------------------------------------
fig3 = figure('Name', '3D Geometry', 'Color', 'w', 'Position', [200 200 700 600]); %[output:19ed84ab]
hold on; grid on; axis equal; %[output:19ed84ab]
view(35, 25); %[output:19ed84ab]

% Plot RIS plane boundaries
minX = min(X_m(:)); maxX = max(X_m(:));
minY = min(Y_m(:)); maxY = max(Y_m(:));
patch('XData', [minX maxX maxX minX], 'YData', [minY minY maxY maxY], ... %[output:19ed84ab]
      'ZData', [0 0 0 0], 'FaceColor', [0.8 0.8 0.8], 'FaceAlpha', 0.4); %[output:19ed84ab]

% Plot Transmitter and Receiver
hTx = scatter3(Tx(1), Tx(2), Tx(3), 150, '^', 'MarkerFaceColor', 'r', 'MarkerEdgeColor', 'k'); %[output:19ed84ab]
hRx = scatter3(Rx(1), Rx(2), Rx(3), 150, 'o', 'MarkerFaceColor', 'b', 'MarkerEdgeColor', 'k'); %[output:19ed84ab]
text(Tx(1), Tx(2), Tx(3)+0.15, 'Tx', 'FontWeight', 'bold'); %[output:19ed84ab]
text(Rx(1), Rx(2), Rx(3)+0.15, 'Rx', 'FontWeight', 'bold'); %[output:19ed84ab]

% Draw Incident and Reflected Rays to Array Center
center_idx = round(Nx/2);
xc = X_m(center_idx, center_idx);
yc = Y_m(center_idx, center_idx);
zc = Z_m(center_idx, center_idx);
plot3([Tx(1) xc], [Tx(2) yc], [Tx(3) zc], 'r--', 'LineWidth', 1.5); %[output:19ed84ab]
plot3([xc Rx(1)], [yc Rx(2)], [zc Rx(3)], 'b--', 'LineWidth', 1.5); %[output:19ed84ab]

legend([hTx, hRx], {'Transmitter', 'Receiver'}, 'Location', 'best', 'FontName', fontName); %[output:19ed84ab]
title('Transmitter-RIS-Receiver 3D Geometry', 'FontWeight', 'bold', 'FontSize', fontSize+2); %[output:19ed84ab]
xlabel('X (m)'); ylabel('Y (m)'); zlabel('Z (m)'); %[output:19ed84ab]
set(gca, 'FontName', fontName, 'FontSize', fontSize); %[output:19ed84ab]

%% ========================================================================
% SECTION 8 – STATISTICS
% =========================================================================
% Calculate required metrics
numON = sum(ControlMatrix(:) == 1);
numOFF = sum(ControlMatrix(:) == 0);
percentON = (numON / TotalElements) * 100;
percentOFF = (numOFF / TotalElements) * 100;

minPhase = min(PhaseWrapped(:));
maxPhase = max(PhaseWrapped(:));
avgPhase = mean(PhaseWrapped(:));

%% ========================================================================
% COMMAND WINDOW OUTPUT
% =========================================================================
disp(' '); %[output:8d8f42a2]
disp('========================================'); %[output:2ed78ceb]
disp('         RIS PHASE CALCULATION'); %[output:43da038e]
disp('========================================'); %[output:6874f300]
fprintf('Frequency               : %.2f GHz\n', f / 1e9); %[output:0c4b7cd6]
fprintf('Array Size              : %d x %d\n', Nx, Ny); %[output:231e3d2c]
fprintf('Number of Elements      : %d\n', TotalElements); %[output:069ab31b]
fprintf('Transmitter Coordinates : [%.2f, %.2f, %.2f] m\n', Tx(1), Tx(2), Tx(3)); %[output:4be7260b]
fprintf('Receiver Coordinates    : [%.2f, %.2f, %.2f] m\n', Rx(1), Rx(2), Rx(3)); %[output:23148d30]
fprintf('Average Phase           : %.2f deg\n', avgPhase); %[output:8cf7bb90]
fprintf('Minimum Phase           : %.2f deg\n', minPhase); %[output:691c60dc]
fprintf('Maximum Phase           : %.2f deg\n', maxPhase); %[output:3b946ac8]
fprintf('ON Elements             : %d (%.1f%%)\n', numON, percentON); %[output:79ad0435]
fprintf('OFF Elements            : %d (%.1f%%)\n', numOFF, percentOFF); %[output:6d08b6bb]
disp('========================================'); %[output:3fe417dd]

